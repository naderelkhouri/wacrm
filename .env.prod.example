# ============================================================
# WcloudAPI Production Environment Variables (.env.prod)
# DO NOT commit real values of this file to version control.
# ============================================================

NODE_ENV=production
PORT=3000

# Site URL and Locales
NEXT_PUBLIC_SITE_URL=https://wcloudapi.dev
NEXT_PUBLIC_APP_LOCALE=pt-BR
ALLOWED_INVITE_HOSTS=wcloudapi.dev,www.wcloudapi.dev,wacrm.admx.tech

# Supabase Database & Auth
NEXT_PUBLIC_SUPABASE_URL=https://api-db.admx.tech
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Django CRM API (Híbrido)
NEXT_PUBLIC_DJANGO_API_URL=https://api-crm.admx.tech

# Security & Secrets
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
# Generate with: openssl rand -hex 32
AUTOMATION_CRON_SECRET=

# Meta WhatsApp Cloud API
# Meta Developer Console -> WhatsApp App -> Basic Settings -> App Secret
META_APP_SECRET=
META_APP_ID=

# PagBank / PagSeguro
PAGSEGURO_ENV=production
PAGSEGURO_TOKEN=
PAGSEGURO_MERCHANT_EMAIL=
PAGSEGURO_WEBHOOK_SECRET=
